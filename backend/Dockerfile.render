# Free online server on Render (render.yaml): one process, SQLite in /tmp, in-process Redis.
# Data resets when the free instance restarts or sleeps; that is fine for family games.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    HARB_ENV=render \
    HARB_DATABASE_URL=sqlite+aiosqlite:////tmp/harb.db \
    HARB_REDIS_URL=memory://
WORKDIR /srv
COPY pyproject.toml ./
COPY app ./app
RUN pip install --no-cache-dir ".[home]"
COPY maps ./maps
COPY alembic.ini ./
COPY alembic ./alembic
# Render passes the port in $PORT; HARB_JWT_SECRET and HARB_ADMIN_KEY come from render.yaml
CMD ["sh", "-c", "alembic upgrade head && python -m app.questions.seed && exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-10000} --workers 1 --no-access-log --proxy-headers --forwarded-allow-ips='*'"]
